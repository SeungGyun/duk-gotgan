# 데이터베이스 (docker compose up -d 로 띄우는 dukgotgan_mysql)
# 3306 은 다른 프로젝트가 쓰고 있어 3307 입니다.
DATABASE_URL=mysql+pymysql://dukgotgan:dukgotgan1234@localhost:3307/dukgotgan?charset=utf8mb4

# 서버
API_HOST=127.0.0.1
API_PORT=8000

# 프론트 개발 서버 주소. vite 프록시를 쓰면 실제로는 동일 출처라 필요 없지만,
# 브라우저가 백엔드를 직접 부르는 구성일 때 필요합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 하루 토큰 상한. UI 상단 미터의 분모입니다. 0 이면 상한 없음으로 보고 미터를 숨깁니다.
DAILY_TOKEN_LIMIT=1000000

# 유튜브 Data API 일일 쿼터 유닛 (search.list 1회 = 100 유닛)
YOUTUBE_UNIT_LIMIT=10000
