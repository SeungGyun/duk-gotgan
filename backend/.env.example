# .env 는 **덮어쓸 것만** 적습니다.
#
# 여기 없는 값은 config/settings.py 의 기본값을 씁니다. 그 파일에는 각 숫자가
# 왜 그 값인지 적혀 있으니, 바꾸기 전에 한 번 읽어 보세요.
#
# 예시 파일에 값을 잔뜩 적어 두면 나중에 코드의 기본값을 고쳐도 **여기 옛날
# 값이 조용히 이깁니다.** 실제로 조회수 300·2년·쇼츠 차단이 그렇게 남아
# 있었어서, 최소한만 남기고 나머지는 주석으로 둡니다.

# ── 꼭 필요한 것 ─────────────────────────────────────────────
# 유튜브 Data API v3 키. Google Cloud Console 에서 무료로 발급합니다.
#   1. console.cloud.google.com → 프로젝트 생성
#   2. API 및 서비스 → 라이브러리 → "YouTube Data API v3" 사용 설정
#   3. 사용자 인증 정보 → 사용자 인증 정보 만들기 → API 키
YOUTUBE_API_KEY=

# ── 아래는 전부 선택입니다 ───────────────────────────────────

# 데이터베이스. 3306 은 다른 프로젝트가 쓰고 있어 3307 입니다.
# DATABASE_URL=mysql+pymysql://dukgotgan:dukgotgan1234@localhost:3307/dukgotgan?charset=utf8mb4

# 서버가 묶이는 주소. 상시 서비스는 ops/api.sh 가 0.0.0.0 으로 띄웁니다
# (폰에서 붙으려면 그래야 합니다). 여기 값은 직접 uvicorn 을 띄울 때만 씁니다.
# API_HOST=127.0.0.1
# API_PORT=8000

# 브라우저가 8000 번을 직접 부르는 구성일 때만 필요합니다. vite 프록시를
# 쓰면 동일 출처라 상관없습니다.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 토큰 상한 — **5시간 창** 단위입니다. 구독 사용량이 그 주기로 풀려서,
# 하루로 재면 오전에 다 쓰고 저녁 내내 놀거나 그 반대가 됩니다.
# 대시보드에서 바꿀 수 있고, **그 값이 여기보다 우선합니다.**
# TOKEN_LIMIT_PER_WINDOW=3000000
# TOKEN_WINDOW_HOURS=5

# 유튜브 일일 쿼터 (search.list 1회 = 100 유닛)
# YOUTUBE_UNIT_LIMIT=10000

# ── 룰 필터 ──────────────────────────────────────────────────
# AI 호출 수를 직접 줄이는, 비용을 좌우하는 가장 큰 손잡이입니다.

# 조회수는 **꺼져 있습니다(0)**. 300 으로 낮춰도 여전히 문제였습니다 —
# 330건 중 157건이 여기서 떨어졌는데 하필 틈새 전문 콘텐츠였습니다
# (287회짜리 24분 인프라 해부 같은 것). 틈새 강의는 정의상 조회수가 적어서,
# 이걸 품질 신호로 쓰면 목적과 반대로 걸립니다.
# RULE_MIN_VIEW_COUNT=0

# 6개월. 2년으로 두었더니 오래된 영상이 줄의 앞을 차지했습니다.
# RULE_MAX_AGE_DAYS=180

# 제목에 이게 들어가면 강의가 아니라 홍보로 봅니다.
# `쇼츠`는 뺐습니다 — 길이로 거르는 편이 정확하고, 제목에 "쇼츠"가 들어간
# 긴 영상까지 같이 떨어뜨릴 이유가 없습니다.
# RULE_TITLE_BLOCKLIST=무료특강,수강신청,할인,이벤트,쿠폰,모집,설명회,체험단,광고,협찬,라이브방송,다시보기

# ── 사람 ─────────────────────────────────────────────────────
# 1인당 활성 키워드 상한. 주인은 예외입니다. 요약 한 편에 8만 토큰이라
# 키워드 60개쯤에서 상한이 걸립니다 — 1인 10개면 대여섯 명입니다.
# MAX_KEYWORDS_PER_USER=10
